bunx lint-staged

# wrap-md: enforce 100-column markdown wrapping on staged files.
# Skipped when absent; AGENTS.md documents this as a repo convention.
if command -v wrap-md >/dev/null 2>&1; then
  wrap-md
fi

bun run typecheck
bun run lint
CI=true bun run test

# fallow: dead exports, complexity, duplication, styling on changed code.
# Silent on pass, full report on fail. Skipped when fallow is absent.
command -v fallow >/dev/null 2>&1 || exit 0
fallow audit --base HEAD --quiet --gate-marker pre-commit
